{
  "manifest_version": 3,
  "name": "CodeSnag",
  "version": "1.0.0",
  "description": "Never Google the same code twice. Save code once, find it in seconds, insert it anywhere. 100% local, no account, no server.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "CodeSnag — your code library",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "options_page": "options.html",
  "background": { "service_worker": "src/background.js" },
  "permissions": ["storage", "activeTab", "contextMenus"],
  "host_permissions": [
    "https://www.google.com/*",
    "https://*.stackoverflow.com/*",
    "https://*.github.com/*",
    "https://*/*"
  ],
  "content_scripts": [
    {
      "matches": ["https://*.stackoverflow.com/*", "https://*.github.com/*", "https://*/*"],
      "js": ["src/content-save.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://*/*"],
      "js": ["src/content-insert.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://www.google.com/search*"],
      "js": ["src/content-google.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
